{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/static/css/(.*)", "destination": "/css/$1" },
    { "source": "/static/js/(.*)", "destination": "/js/$1" },
    { "source": "/static/(.*)", "destination": "/$1" }
  ]
}

